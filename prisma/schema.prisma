// Obsidian Tread — Prisma schema
// This models the full production data layer. The running demo in this
// repository uses an in-memory/localStorage mock data layer (see lib/data
// and lib/server) so it works without a provisioned database; this schema
// is the target shape for wiring up a real Postgres-backed deployment.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Season {
  ALL_SEASON
  SUMMER
  WINTER
  ALL_TERRAIN
  PERFORMANCE
}

enum OrderStatus {
  PROCESSING
  CONFIRMED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum ProductBadge {
  NEW
  BEST_SELLER
  STAFF_PICK
  SALE
  ECO
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  country     String
  tagline     String
  logoInitial String
  featured    Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  icon        String
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  sku                String              @unique
  description        String
  highlights         String[]
  features           String[]
  badges             ProductBadge[]
  price              Decimal             @db.Decimal(10, 2)
  compareAtPrice     Decimal?            @db.Decimal(10, 2)
  currency           String              @default("USD")
  stock              Int                 @default(0)
  rating             Float               @default(0)
  reviewCount        Int                 @default(0)
  warrantyMiles      Int
  mileageRatingMiles Int
  weightLbs          Int
  brand              Brand               @relation(fields: [brandId], references: [id])
  brandId            String
  category           Category            @relation(fields: [categoryId], references: [id])
  categoryId         String
  spec               TireSpecification?
  performance        PerformanceRating?
  images             ProductImage[]
  reviews            Review[]
  orderItems         OrderItem[]
  compatibilities    Compatibility[]
  cartItems          CartItem[]
  wishlistedBy       WishlistItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([brandId])
  @@index([categoryId])
}

model TireSpecification {
  id          String  @id @default(cuid())
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String  @unique
  width       Int
  aspectRatio Int
  diameter    Int
  loadIndex   Int
  speedRating String
  season      Season
  runFlat     Boolean @default(false)
  studdable   Boolean @default(false)

  @@index([width, aspectRatio, diameter])
}

model PerformanceRating {
  id             String  @id @default(cuid())
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String  @unique
  wetGrip        Float
  dryGrip        Float
  treadwear      Float
  noise          Float
  fuelEfficiency Float
  snowTraction   Float
  comfort        Float
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  alt       String
  position  Int     @default(0)
}

model Vehicle {
  id               String            @id @default(cuid())
  year             Int
  make             String
  model            String
  trim             String
  oemSize          String
  compatibilities  Compatibility[]
  savedByCustomers CustomerVehicle[]

  @@unique([year, make, model, trim])
  @@index([make, model])
}

model Compatibility {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  vehicleId String

  @@unique([productId, vehicleId])
}

model Customer {
  id            String            @id @default(cuid())
  name          String
  email         String            @unique
  phone         String?
  passwordHash  String
  passwordSalt  String
  avatarInitial String?
  memberSince   DateTime          @default(now())
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  vehicles      CustomerVehicle[]
  wishlist      WishlistItem[]
  cart          Cart?
  sessions      Session[]
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model CustomerVehicle {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  vehicleId  String
  nickname   String?
  createdAt  DateTime @default(now())

  @@unique([customerId, vehicleId])
}

model Address {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  label      String
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String
  zip        String
  country    String
  phone      String
  isDefault  Boolean  @default(false)
  orders     Order[]

  @@index([customerId])
}

model Order {
  id                String      @id @default(cuid())
  customer          Customer    @relation(fields: [customerId], references: [id])
  customerId        String
  status            OrderStatus @default(PROCESSING)
  items             OrderItem[]
  subtotal          Decimal     @db.Decimal(10, 2)
  shipping          Decimal     @db.Decimal(10, 2)
  tax               Decimal     @db.Decimal(10, 2)
  discount          Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  shippingAddress   Address     @relation(fields: [shippingAddressId], references: [id])
  shippingAddressId String
  coupon            Coupon?     @relation(fields: [couponCode], references: [code])
  couponCode        String?
  installer         Installer?  @relation(fields: [installerId], references: [id])
  installerId       String?
  installationDate  DateTime?
  installationSlot  String?
  trackingNumber    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  name      String
  size      String
  image     String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
}

model Review {
  id               String    @id @default(cuid())
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  customer         Customer? @relation(fields: [customerId], references: [id])
  customerId       String?
  customerName     String
  rating           Int
  title            String
  body             String
  verifiedPurchase Boolean   @default(false)
  helpfulCount     Int       @default(0)
  vehicle          String?
  createdAt        DateTime  @default(now())

  @@index([productId])
}

model Installer {
  id            String   @id @default(cuid())
  name          String
  addressLine   String
  city          String
  state         String
  zip           String
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  services      String[]
  nextAvailable String?
  orders        Order[]
}

model Coupon {
  code        String     @id
  description String
  type        CouponType
  value       Float
  minSubtotal Float      @default(0)
  expiresAt   DateTime
  orders      Order[]
}

model Cart {
  id         String     @id @default(cuid())
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String     @unique
  items      CartItem[]
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String
  content       String[]
  category      String
  author        String
  readMinutes   Int
  coverGradient String
  publishedAt   DateTime @default(now())
}
